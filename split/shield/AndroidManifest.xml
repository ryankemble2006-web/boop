<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <application android:name="com.boop.alpha1.UnifiedApplication" android:allowBackup="false"
        android:label="BOOP Shield" android:icon="@drawable/boop_eyes" android:banner="@drawable/boop_tv_banner">
        <activity android:name="com.boop.alpha1.UnifiedEntryActivity" android:exported="true"
            android:launchMode="singleTask" android:theme="@style/Theme.BOOP" android:banner="@drawable/boop_tv_banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Preserve the authority consumed by the existing signed Johnny app. -->
        <provider android:name="com.boop.alpha1.JohnnyStateProvider"
            android:authorities="com.boop.alpha1.johnny_states;com.boop.shieldoverlay.johnny_states"
            android:exported="true" android:grantUriPermissions="false" />
    </application>
</manifest>
